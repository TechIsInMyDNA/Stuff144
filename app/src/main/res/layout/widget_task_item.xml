<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/item_row"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#121212"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:padding="6dp">

    <TextView android:id="@+id/tvCheck" android:layout_width="wrap_content" android:layout_height="wrap_content" 
        android:text="☐" android:textSize="14sp" android:textColor="#00E5FF" android:paddingRight="8dp"/>
    
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
        <TextView android:id="@+id/tvTaskText" android:layout_width="match_parent" android:layout_height="wrap_content" 
            android:textColor="#FFFFFF" android:textSize="13sp" android:fontFamily="sans-serif-medium"/>
        <TextView android:id="@+id/tvDate" android:layout_width="match_parent" android:layout_height="wrap_content" 
            android:textColor="#666666" android:textSize="10sp"/>
    </LinearLayout>
</LinearLayout>
